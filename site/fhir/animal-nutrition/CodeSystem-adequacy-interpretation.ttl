<https://openanimalnutrition.org/fhir/animal-nutrition/CodeSystem/adequacy-interpretation> a fhir:CodeSystem ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "adequacy-interpretation"] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: CodeSystem adequacy-interpretation</b></p><a name=\"adequacy-interpretation\"> </a><a name=\"hcadequacy-interpretation\"> </a><p>This case-sensitive code system <code>https://openanimalnutrition.org/fhir/animal-nutrition/CodeSystem/adequacy-interpretation</code> defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">adequate<a name=\"adequacy-interpretation-adequate\"> </a></td><td>Meets the requirement</td><td/></tr><tr><td style=\"white-space:nowrap\">deficient<a name=\"adequacy-interpretation-deficient\"> </a></td><td>Below the minimum</td><td><div><p>Below a minimum set by the applied standard, including one raised for a caloric restriction or by the AAFCO dry matter factor, and the arginine and large-breed puppy calcium minimums the source template computes from a standard's own rule. Whether a value below a minimum that the source template supplies or computes otherwise is deficient is an open point. Proposed, pending ratification.</p>\n</div></td></tr><tr><td style=\"white-space:nowrap\">excess<a name=\"adequacy-interpretation-excess\"> </a></td><td>Above an authoritative maximum</td><td><div><p>Above an authoritative maximum (maxProvenance <code>authoritative</code>), and not below a minimum set by the applied standard, including one raised for a caloric restriction or by the AAFCO dry matter factor, as stated on the <a href=\"band-computation.html\">Decile Basis and Band Computation</a> page. Not used above conditional, template-set or derived-provisional maximums. Proposed, pending ratification.</p>\n</div></td></tr><tr><td style=\"white-space:nowrap\">complete-balanced<a name=\"adequacy-interpretation-complete-balanced\"> </a></td><td>Overall: complete and balanced</td><td/></tr><tr><td style=\"white-space:nowrap\">not-complete-balanced<a name=\"adequacy-interpretation-not-complete-balanced\"> </a></td><td>Overall: not complete and balanced</td><td/></tr></table></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:url [ fhir:v "https://openanimalnutrition.org/fhir/animal-nutrition/CodeSystem/adequacy-interpretation"^^xsd:anyURI] ; # 
  fhir:identifier ( [
     fhir:system [ fhir:v "urn:ietf:rfc:3986"^^xsd:anyURI ] ;
     fhir:value [ fhir:v "urn:oid:2.16.840.1.113883.4.642.40.1004.16.1" ]
  ] ) ; # 
  fhir:version [ fhir:v "0.1.0"] ; # 
  fhir:name [ fhir:v "AdequacyInterpretationCS"] ; # 
  fhir:title [ fhir:v "Adequacy Interpretation"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2026-10-26T20:14:00+00:00"^^xsd:dateTime] ; # 
  fhir:publisher [ fhir:v "DVM Consulting, Inc. (provisional steward)"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "DVM Consulting, Inc. (provisional steward)" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "https://openanimalnutrition.org" ]
     ] )
  ] ) ; # 
  fhir:description [ fhir:v "Per-nutrient and overall interpretations of a diet's nutrient levels against the applied requirement standard. The rules for `deficient` and `excess` are stated, proposed and pending ratification, on the [Decile Basis and Band Computation](band-computation.html) page."] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [ fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "001" ]
     ] )
  ] ) ; # 
  fhir:caseSensitive [ fhir:v true] ; # 
  fhir:content [ fhir:v "complete"] ; # 
  fhir:count [ fhir:v "5"^^xsd:nonNegativeInteger] ; # 
  fhir:concept ( [
     fhir:code [ fhir:v "adequate" ] ;
     fhir:display [ fhir:v "Meets the requirement" ]
  ] [
     fhir:code [ fhir:v "deficient" ] ;
     fhir:display [ fhir:v "Below the minimum" ] ;
     fhir:definition [ fhir:v "Below a minimum set by the applied standard, including one raised for a caloric restriction or by the AAFCO dry matter factor, and the arginine and large-breed puppy calcium minimums the source template computes from a standard's own rule. Whether a value below a minimum that the source template supplies or computes otherwise is deficient is an open point. Proposed, pending ratification." ]
  ] [
     fhir:code [ fhir:v "excess" ] ;
     fhir:display [ fhir:v "Above an authoritative maximum" ] ;
     fhir:definition [ fhir:v "Above an authoritative maximum (maxProvenance `authoritative`), and not below a minimum set by the applied standard, including one raised for a caloric restriction or by the AAFCO dry matter factor, as stated on the [Decile Basis and Band Computation](band-computation.html) page. Not used above conditional, template-set or derived-provisional maximums. Proposed, pending ratification." ]
  ] [
     fhir:code [ fhir:v "complete-balanced" ] ;
     fhir:display [ fhir:v "Overall: complete and balanced" ]
  ] [
     fhir:code [ fhir:v "not-complete-balanced" ] ;
     fhir:display [ fhir:v "Overall: not complete and balanced" ]
  ] ) . # 

