  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Extension" ] ;
       fhir:path [ fhir:v "Extension" ] ;
       fhir:short [ fhir:v "Caloric Restriction" ] ;
       fhir:definition [ fhir:v "The intentional caloric restriction that the check was run under, as a\npercentage of the animal's energy need, in UCUM `%`: 25 means that the animal\nis fed 25% less energy than it needs. Most of the applied standard's per-Mcal\nminimums are then multiplied by 1 ÷ (1 − restriction ÷ 100) (under an AAFCO\nselection, together with any AAFCO dry matter factor), so a nutrient can be\n`deficient` although it meets the minimum that applies with no restriction.\nThe source template accepts 0 (none) or a number from 1 to 55. Present only\nfor a restriction above 0, and absent when none was entered (blank or 0 in the\ntemplate). An intake\nentered in place of the calculated energy requirement is not a restriction.\nNeither it nor the template's figure for how far it falls below that\nrequirement (cell N4 on the template's Standards tab) is recorded here. Which\nminimums are raised, and the rule that makes a value below them `deficient`,\nare stated, proposed and pending ratification, on the\n[Decile Basis and Band Computation](band-computation.html) page." ]
     ] [
       fhir:id [ fhir:v "Extension.extension" ] ;
       fhir:path [ fhir:v "Extension.extension" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Extension.url" ] ;
       fhir:path [ fhir:v "Extension.url" ] ;
       fhir:fixed [
         a fhir:uri ;
         fhir:v "https://openanimalnutrition.org/fhir/animal-nutrition/StructureDefinition/caloric-restriction"^^xsd:anyURI
       ]
     ] [
       fhir:id [ fhir:v "Extension.value[x]" ] ;
       fhir:path [ fhir:v "Extension.value[x]" ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Quantity"^^xsd:anyURI ]
       ] )
     ] [
       fhir:id [ fhir:v "Extension.value[x].value" ] ;
       fhir:path [ fhir:v "Extension.value[x].value" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "Extension.value[x].comparator" ] ;
       fhir:path [ fhir:v "Extension.value[x].comparator" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Extension.value[x].system" ] ;
       fhir:path [ fhir:v "Extension.value[x].system" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:pattern [
         a fhir:uri ;
         fhir:v "http://unitsofmeasure.org"^^xsd:anyURI
       ]
     ] [
       fhir:id [ fhir:v "Extension.value[x].code" ] ;
       fhir:path [ fhir:v "Extension.value[x].code" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:pattern [
         a fhir:code ;
         fhir:v "%"
       ]
     ] )
  ] . # 

