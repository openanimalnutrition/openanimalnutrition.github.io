     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: CodeSystem nutrient-decile</b></p><a name=\"nutrient-decile\"> </a><a name=\"hcnutrient-decile\"> </a><p>This case-sensitive code system <code>https://openanimalnutrition.org/fhir/animal-nutrition/CodeSystem/nutrient-decile</code> defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td></tr><tr><td style=\"white-space:nowrap\">below-min-lt25<a name=\"nutrient-decile-below-min-lt25\"> </a></td><td>Very Severely Restricted (&lt;25% of Min)</td></tr><tr><td style=\"white-space:nowrap\">below-min-25-50<a name=\"nutrient-decile-below-min-25-50\"> </a></td><td>Severely Restricted (25 to &lt;50% of Min)</td></tr><tr><td style=\"white-space:nowrap\">below-min-50-75<a name=\"nutrient-decile-below-min-50-75\"> </a></td><td>Moderately Restricted (50 to &lt;75% of Min)</td></tr><tr><td style=\"white-space:nowrap\">below-min-75-100<a name=\"nutrient-decile-below-min-75-100\"> </a></td><td>Slightly Restricted (75 to &lt;100% of Min)</td></tr><tr><td style=\"white-space:nowrap\">range-d1<a name=\"nutrient-decile-range-d1\"> </a></td><td>Lowest/Just Above Min (Min to &lt;10% of Range)</td></tr><tr><td style=\"white-space:nowrap\">range-d2<a name=\"nutrient-decile-range-d2\"> </a></td><td>Lower (10 to &lt;20% of Range)</td></tr><tr><td style=\"white-space:nowrap\">range-d3<a name=\"nutrient-decile-range-d3\"> </a></td><td>Low (20 to &lt;30% of Range)</td></tr><tr><td style=\"white-space:nowrap\">range-d4<a name=\"nutrient-decile-range-d4\"> </a></td><td>Low Moderate (30 to &lt;40% of Range)</td></tr><tr><td style=\"white-space:nowrap\">range-d5<a name=\"nutrient-decile-range-d5\"> </a></td><td>Mid Moderate (40 to &lt;50% of Range)</td></tr><tr><td style=\"white-space:nowrap\">range-d6<a name=\"nutrient-decile-range-d6\"> </a></td><td>High Moderate (50 to &lt;60% of Range)</td></tr><tr><td style=\"white-space:nowrap\">range-d7<a name=\"nutrient-decile-range-d7\"> </a></td><td>High (60 to &lt;70% of Range)</td></tr><tr><td style=\"white-space:nowrap\">range-d8<a name=\"nutrient-decile-range-d8\"> </a></td><td>Higher (70 to &lt;80% of Range)</td></tr><tr><td style=\"white-space:nowrap\">range-d9<a name=\"nutrient-decile-range-d9\"> </a></td><td>Near Highest (80 to &lt;90% of Range)</td></tr><tr><td style=\"white-space:nowrap\">range-d10<a name=\"nutrient-decile-range-d10\"> </a></td><td>Highest (90% of Range or Greater)</td></tr></table></div>"^^rdf:XMLLiteral ]
