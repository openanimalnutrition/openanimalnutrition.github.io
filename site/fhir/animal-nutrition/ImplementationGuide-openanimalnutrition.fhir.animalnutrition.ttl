     fhir:resource ( [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "CodeSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/CodeSystem/adequacy-interpretation> ;
         fhir:reference [ fhir:v "CodeSystem/adequacy-interpretation" ]
       ] ;
       fhir:name [ fhir:v "Adequacy Interpretation" ] ;
       fhir:description [ fhir:v "Per-nutrient and overall interpretations of a diet's nutrient levels against the applied requirement standard. The rules for `deficient` and `excess` are stated, proposed and pending ratification, on the [Decile Basis and Band Computation](band-computation.html) page." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/ValueSet/adequacy-interpretation-vs> ;
         fhir:reference [ fhir:v "ValueSet/adequacy-interpretation-vs" ]
       ] ;
       fhir:name [ fhir:v "Adequacy Interpretation Value Set" ] ;
       fhir:description [ fhir:v "All codes in the Adequacy Interpretation code system." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "Observation"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/Observation/ExampleRestrictedMaintenanceAdequacy> ;
         fhir:reference [ fhir:v "Observation/ExampleRestrictedMaintenanceAdequacy" ]
       ] ;
       fhir:name [ fhir:v "Adult-maintenance adequacy under a 25% caloric restriction, canine, vs NRC" ] ;
       fhir:description [ fhir:v "A dog fed 25% less energy than it needs, checked against NRC's recommended allowances for adult dogs at maintenance, under the caloric-restriction rule proposed, pending ratification, on the [Decile Basis and Band Computation](band-computation.html) page. Calcium at 1.2 g/Mcal meets NRC's minimum of 1 g/Mcal, but the restriction raises the minimum to 4/3 g/Mcal (recorded as 1.3333333, at 7 decimal places), so calcium is deficient. The overall verdict shown is illustrative: how it follows from the per-nutrient results is an open point on that page." ] ;
       fhir:isExample [ fhir:v true ] ;
       fhir:profile ( [
         fhir:v "https://openanimalnutrition.org/fhir/animal-nutrition/StructureDefinition/animal-nutrient-adequacy"^^xsd:anyURI ;
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/StructureDefinition/animal-nutrient-adequacy>
       ] )
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "Observation"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/Observation/ExampleAdultMaintenanceAdequacy> ;
         fhir:reference [ fhir:v "Observation/ExampleAdultMaintenanceAdequacy" ]
       ] ;
       fhir:name [ fhir:v "Adult-maintenance adequacy, canine, vs AAFCO" ] ;
       fhir:description [ fhir:v "Adequacy of a canine adult-maintenance diet against AAFCO, with one nutrient under an authoritative maximum (calcium) and one under a derived-provisional ceiling (potassium). The overall verdict shown is illustrative: how it follows from the per-nutrient results is an open point on the [Decile Basis and Band Computation](band-computation.html) page." ] ;
       fhir:isExample [ fhir:v true ] ;
       fhir:profile ( [
         fhir:v "https://openanimalnutrition.org/fhir/animal-nutrition/StructureDefinition/animal-nutrient-adequacy"^^xsd:anyURI ;
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/StructureDefinition/animal-nutrient-adequacy>
       ] )
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:resource"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/StructureDefinition/animal-nutrient-adequacy> ;
         fhir:reference [ fhir:v "StructureDefinition/animal-nutrient-adequacy" ]
       ] ;
       fhir:name [ fhir:v "Animal Nutrient Adequacy Assessment" ] ;
       fhir:description [ fhir:v "The result of the agnostic, mathematical check of a diet's resolved nutrient\nprofile against a selected requirement standard (NRC / AAFCO / FEDIAF) for a\ngiven species and life stage.\n\nEach assessed nutrient is a component carrying the diet's level, the applicable\nmin/max requirement range, the common-basis decile expression, and a\nper-nutrient interpretation. The decile expression is computed as stated,\nproposed and pending ratification, on the\n[Decile Basis and Band Computation](band-computation.html) page. The top-level\ninterpretation is the overall complete-and-balanced verdict.\n\nRatio nutrients such as Ca:P are components like any other nutrient, with a\nunitless quantity (UCUM `1`). Non-linear ratio nutrients are excluded from the\ncomponent model by design.\n\nA component's interpretation is `excess` only when the value is above an\nauthoritative maximum, one set by a standards body for the animal and the use\nit is applied to (maxProvenance\n`authoritative`), and not below a minimum set by the applied standard,\nincluding one raised for a caloric restriction or by the AAFCO dry matter\nfactor (below). Above a conditional, template-set or derived-provisional\nmaximum, and not below the minimum, the interpretation stays `adequate`. The\nband is then `range-d10` (\"Highest (90% of Range or\nGreater)\"), which alone does not show that the maximum was exceeded:\nreferenceRange.high holds the maximum, and maxProvenance says what kind it is.\n\nWhere a caloric restriction, or the AAFCO dry matter factor for a food below\n4 kcal/g of dry matter, raises a minimum set by the applied standard,\nreferenceRange.low holds the raised minimum, and the band is computed from it.\nA value below it is `deficient`, even if it meets the minimum that applies\nwith no adjustment. A verdict checked under a caloric restriction above 0 records the\npercentage in `caloricRestriction`. This rule, the condition on `excess` above,\nand which minimums they cover are stated, proposed and pending ratification, on\nthe [Decile Basis and Band Computation](band-computation.html) page.\n\n`performer` is optional. When a veterinarian, nutritionist or clinic ran or\nreviewed the check, name them (Practitioner, PractitionerRole or Organization).\nThe organization that only operates the checking software is not the performer\nunless it also reviewed this verdict. Software cannot be the performer of an\nObservation in FHIR R5 (`performer` does not accept a Device). When software\ncomputed the verdict, record it in `device`: a Device whose `name` and\n`version` give the software's name and version, so a reader can tell which\nchecker, and which version of it, produced the verdict.\n\nSCOPE: this profile models the VERDICT. Ingredient selection, fortification,\nand rounding (i.e. how a passing diet is produced) are out of scope by design." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "CodeSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/CodeSystem/animal-nutrient> ;
         fhir:reference [ fhir:v "CodeSystem/animal-nutrient" ]
       ] ;
       fhir:name [ fhir:v "Animal Nutrients (STUB)" ] ;
       fhir:description [ fhir:v "STUB. Populate from the canonical nutrient list; map to SNOMED-vet / LOINC where possible. Ratio nutrients (e.g. Ca:P) need explicit handling, and non-linear ratios are excluded from the component model by design (see the [Animal Nutrient Adequacy Assessment](StructureDefinition-animal-nutrient-adequacy.html) profile). Which ratios count as non-linear is an open point on the [Decile Basis and Band Computation](band-computation.html) page." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/ValueSet/animal-nutrient-vs> ;
         fhir:reference [ fhir:v "ValueSet/animal-nutrient-vs" ]
       ] ;
       fhir:name [ fhir:v "Animal Nutrients Value Set" ] ;
       fhir:description [ fhir:v "All codes in the Animal Nutrients code system (a stub in v0.1)." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
