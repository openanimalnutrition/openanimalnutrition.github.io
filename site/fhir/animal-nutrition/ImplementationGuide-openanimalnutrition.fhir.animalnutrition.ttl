         fhir:reference [ fhir:v "CodeSystem/animal-species" ]
       ] ;
       fhir:name [ fhir:v "Animal Species (STUB)" ] ;
       fhir:description [ fhir:v "STUB. v0.1 implemented coverage only. TODO: bind to an external species value set." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
