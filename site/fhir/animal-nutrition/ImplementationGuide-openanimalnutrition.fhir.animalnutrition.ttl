           fhir:v "StructureDefinition:extension"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/StructureDefinition/nutrient-decile> ;
         fhir:reference [ fhir:v "StructureDefinition/nutrient-decile" ]
       ] ;
       fhir:name [ fhir:v "Nutrient Decile (Common-Basis Expression)" ] ;
       fhir:description [ fhir:v "The diet's level for this nutrient on the common mathematical basis used to compare across standards, expressed as a band of the Dynamic Decile System: four bands below the minimum and ten deciles from the minimum to the range high. Where an entry gets a band, a value above the range high is in range-d10 (Highest) unless it is below the minimum. The decile basis and band computation are stated on the [Decile Basis and Band Computation](band-computation.html) page, proposed and pending ratification by the governance body." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "CodeSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/CodeSystem/nutrient-decile> ;
         fhir:reference [ fhir:v "CodeSystem/nutrient-decile" ]
       ] ;
       fhir:name [ fhir:v "Nutrient Decile Bands" ] ;
       fhir:description [ fhir:v "The 14 bands of the Dynamic Decile System: four bands below the requirement minimum, as a share of the minimum, and ten deciles from the minimum to the range high. Where an entry gets a band, a value above the range high is in range-d10 unless it is below the minimum. The computation is stated, proposed and pending ratification, on the [Decile Basis and Band Computation](band-computation.html) page." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/ValueSet/nutrient-decile-vs> ;
         fhir:reference [ fhir:v "ValueSet/nutrient-decile-vs" ]
       ] ;
       fhir:name [ fhir:v "Nutrient Decile Bands Value Set" ] ;
       fhir:description [ fhir:v "All codes in the Nutrient Decile Bands code system." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
