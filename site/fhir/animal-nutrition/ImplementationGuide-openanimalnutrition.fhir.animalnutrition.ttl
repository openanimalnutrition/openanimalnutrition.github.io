           a fhir:string ;
           fhir:v "StructureDefinition:extension"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/StructureDefinition/nutrient-life-stage> ;
         fhir:reference [ fhir:v "StructureDefinition/nutrient-life-stage" ]
       ] ;
       fhir:name [ fhir:v "Life Stage" ] ;
       fhir:description [ fhir:v "The life stage whose requirements were applied (e.g. growth, adult maintenance). A variable selection." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "CodeSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/CodeSystem/life-stage> ;
         fhir:reference [ fhir:v "CodeSystem/life-stage" ]
       ] ;
       fhir:name [ fhir:v "Life Stages" ] ;
       fhir:description [ fhir:v "Life stages for which requirement standards set nutrient requirements." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/ValueSet/life-stage-vs> ;
         fhir:reference [ fhir:v "ValueSet/life-stage-vs" ]
       ] ;
       fhir:name [ fhir:v "Life Stages Value Set" ] ;
       fhir:description [ fhir:v "All codes in the Life Stages code system." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:extension"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/StructureDefinition/maximum-provenance> ;
         fhir:reference [ fhir:v "StructureDefinition/maximum-provenance" ]
       ] ;
       fhir:name [ fhir:v "Maximum Provenance" ] ;
       fhir:description [ fhir:v "The kind of maximum a nutrient's range high is: AUTHORITATIVE (set by a standards body for the animal and the use it is applied\nto), CONDITIONAL (a standard's figure with a condition the check\ndoes not verify), TEMPLATE-SET (set or computed by the source template) or\nDERIVED-PROVISIONAL (computed by a disclosed rule from the minimum). Only a\nvalue above an authoritative maximum is `excess`. How the source template's\nmaximum types map to these codes is stated, proposed and pending ratification,\non the [Decile Basis and Band Computation](band-computation.html) page.\n\nDerived ceilings prioritize consistency and determinism, NOT toxicological\ncalibration, and are revisable by the governance body. This flag exists so a\nconsumer can see at a glance which ceilings are authoritative and which are\nnot." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "CodeSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/CodeSystem/maximum-provenance-code> ;
         fhir:reference [ fhir:v "CodeSystem/maximum-provenance-code" ]
       ] ;
       fhir:name [ fhir:v "Maximum Provenance Codes" ] ;
       fhir:description [ fhir:v "The kind of maximum a nutrient's range high is, which decides whether a value above it can be `excess`: only an authoritative maximum can. How the source template's maximum types map to these codes is stated, proposed and pending ratification, under Maximum types on the [Decile Basis and Band Computation](band-computation.html) page." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
