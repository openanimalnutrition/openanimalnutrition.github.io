       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/ValueSet/animal-species-vs> ;
         fhir:reference [ fhir:v "ValueSet/animal-species-vs" ]
       ] ;
       fhir:name [ fhir:v "Animal Species Value Set" ] ;
       fhir:description [ fhir:v "All codes in the Animal Species code system (a stub in v0.1)." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:extension"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/StructureDefinition/applied-requirement-standard> ;
         fhir:reference [ fhir:v "StructureDefinition/applied-requirement-standard" ]
       ] ;
       fhir:name [ fhir:v "Applied Requirement Standard" ] ;
       fhir:description [ fhir:v "Which published requirement standard the adequacy check was run against, by its edition's code when the edition is known (for example AAFCO-2026). A variable selection, never hardcoded into the check." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:extension"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/StructureDefinition/caloric-restriction> ;
         fhir:reference [ fhir:v "StructureDefinition/caloric-restriction" ]
       ] ;
       fhir:name [ fhir:v "Caloric Restriction" ] ;
       fhir:description [ fhir:v "The intentional caloric restriction that the check was run under, as a\npercentage of the animal's energy need, in UCUM `%`: 25 means that the animal\nis fed 25% less energy than it needs. Most of the applied standard's per-Mcal\nminimums are then multiplied by 1 ÷ (1 − restriction ÷ 100) (under an AAFCO\nselection, together with any AAFCO dry matter factor), so a nutrient can be\n`deficient` although it meets the minimum that applies with no restriction.\nThe source template accepts 0 (none) or a number from 1 to 55. Present only\nfor a restriction above 0, and absent when none was entered (blank or 0 in the\ntemplate). An intake\nentered in place of the calculated energy requirement is not a restriction.\nNeither it nor the template's figure for how far it falls below that\nrequirement (cell N4 on the template's Standards tab) is recorded here. Which\nminimums are raised, and the rule that makes a value below them `deficient`,\nare stated, proposed and pending ratification, on the\n[Decile Basis and Band Computation](band-computation.html) page." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "Patient"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/Patient/ExampleCaninePatient> ;
         fhir:reference [ fhir:v "Patient/ExampleCaninePatient" ]
       ] ;
       fhir:name [ fhir:v "Example canine patient" ] ;
       fhir:description [ fhir:v "A dog, with species carried by the R5 patient-animal extension." ] ;
       fhir:isExample [ fhir:v true ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "Device"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/Device/ExampleAdequacyChecker> ;
         fhir:reference [ fhir:v "Device/ExampleAdequacyChecker" ]
       ] ;
       fhir:name [ fhir:v "Example checking software" ] ;
       fhir:description [ fhir:v "A placeholder for the software that computed the verdict, with its name and version." ] ;
       fhir:isExample [ fhir:v true ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
