           a fhir:string ;
           fhir:v "Practitioner"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/Practitioner/ExampleVeterinarian> ;
         fhir:reference [ fhir:v "Practitioner/ExampleVeterinarian" ]
       ] ;
       fhir:name [ fhir:v "Example veterinarian" ] ;
       fhir:description [ fhir:v "A placeholder veterinarian who ran or reviewed the check." ] ;
       fhir:isExample [ fhir:v true ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
