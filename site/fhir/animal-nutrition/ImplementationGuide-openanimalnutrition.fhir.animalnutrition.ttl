  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\"><p class=\"res-header-id\"><b>Generated Narrative: ImplementationGuide openanimalnutrition.fhir.animalnutrition</b></p><a name=\"openanimalnutrition.fhir.animalnutrition\"> </a><a name=\"hcopenanimalnutrition.fhir.animalnutrition\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\">Language: en</p></div><h2>OpenAnimalNutrition</h2><p>The official URL for this implementation guide is: </p><pre>https://openanimalnutrition.org/fhir/animal-nutrition/ImplementationGuide/openanimalnutrition.fhir.animalnutrition</pre><div><p>A FHIR Implementation Guide for representing and verifying the nutritional adequacy of an animal diet against published requirement standards (NRC, AAFCO, FEDIAF), expressed on a common mathematical basis. Species-agnostic by design; v0.1 binds canine and feline coverage. This guide models the adequacy VERDICT, not the means of producing a passing diet.</p>\n</div></div>"^^rdf:XMLLiteral ]
  ] ; # 
