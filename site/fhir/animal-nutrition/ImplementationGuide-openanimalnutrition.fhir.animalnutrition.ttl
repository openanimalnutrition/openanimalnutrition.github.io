         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://openanimalnutrition.org/fhir/animal-nutrition/ValueSet/maximum-provenance-vs> ;
         fhir:reference [ fhir:v "ValueSet/maximum-provenance-vs" ]
       ] ;
       fhir:name [ fhir:v "Maximum Provenance Value Set" ] ;
       fhir:description [ fhir:v "All codes in the Maximum Provenance Codes code system." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
