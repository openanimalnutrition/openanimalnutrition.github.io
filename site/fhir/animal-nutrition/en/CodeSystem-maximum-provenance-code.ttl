# - resource -------------------------------------------------------------------

<https://openanimalnutrition.org/fhir/animal-nutrition/CodeSystem/maximum-provenance-code> a fhir:CodeSystem ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "maximum-provenance-code"] ; # 
  fhir:language [ fhir:v "en"] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: CodeSystem maximum-provenance-code</b></p><a name=\"maximum-provenance-code\"> </a><a name=\"hcmaximum-provenance-code\"> </a><p>This case-sensitive code system <code>https://openanimalnutrition.org/fhir/animal-nutrition/CodeSystem/maximum-provenance-code</code> defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">authoritative<a name=\"maximum-provenance-code-authoritative\"> </a></td><td>Authoritative (set by a standards body)</td><td>A maximum or safe upper limit that a standards body sets for the animal and use it is applied to: in the source template, NRC's safe upper limits (as printed, as greater-than values and per kg BW^0.75 or BW^0.67, except those NRC states only for its reference kitten or queen), NRC's presumed safe maximum for choline, AAFCO's maximums (except while the AAFCO dry matter factor applies) and FEDIAF's nutritional maximums (except one used beyond the life stage it is stated for), and a maximum the source template copies from one of these. A value above it, and not below a minimum set by the applied standard, is `excess`.</td></tr><tr><td style=\"white-space:nowrap\">conditional<a name=\"maximum-provenance-code-conditional\"> </a></td><td>Conditional (a standard's figure with a condition the check does not verify)</td><td>A standard's figure that is not a maximum for every diet and animal the check covers: a maximum that applies only under a condition the check does not verify (for example a FEDIAF legal maximum, for nutrients added as additives), a maximum used beyond the life stage or reference animal it is stated for, a level a FEDIAF footnote states to be safe, or an AAFCO maximum while the AAFCO dry matter factor applies. A value above it is not `excess`.</td></tr><tr><td style=\"white-space:nowrap\">template-set<a name=\"maximum-provenance-code-template-set\"> </a></td><td>Template-set (set or computed by the source template)</td><td>A maximum that the source template sets or computes itself: its own estimates, fixed values and maximums calculated from other limits. A value above it is not `excess`.</td></tr><tr><td style=\"white-space:nowrap\">derived-provisional<a name=\"maximum-provenance-code-derived-provisional\"> </a></td><td>Derived-provisional (computed from the minimum; revisable)</td><td>The minimum times a disclosed multiplier, where no maximum is set: a banding device, not a safe limit. A value above it is not `excess`.</td></tr></table></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:url [ fhir:v "https://openanimalnutrition.org/fhir/animal-nutrition/CodeSystem/maximum-provenance-code"^^xsd:anyURI] ; # 
  fhir:identifier ( [
     fhir:system [ fhir:v "urn:ietf:rfc:3986"^^xsd:anyURI ] ;
     fhir:value [ fhir:v "urn:oid:2.16.840.1.113883.4.642.40.1004.16.5" ]
  ] ) ; # 
  fhir:version [ fhir:v "0.1.0"] ; # 
  fhir:name [ fhir:v "MaximumProvenanceCS"] ; # 
  fhir:title [ fhir:v "Maximum Provenance Codes"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2026-10-26T20:14:00+00:00"^^xsd:dateTime] ; # 
  fhir:publisher [ fhir:v "DVM Consulting, Inc. (provisional steward)"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "DVM Consulting, Inc. (provisional steward)" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "https://openanimalnutrition.org" ]
     ] )
  ] ) ; # 
  fhir:description [ fhir:v "The kind of maximum a nutrient's range high is, which decides whether a value above it can be `excess`: only an authoritative maximum can. How the source template's maximum types map to these codes is stated, proposed and pending ratification, under Maximum types on the [Decile Basis and Band Computation](band-computation.html) page."] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [ fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "001" ]
     ] )
  ] ) ; # 
  fhir:caseSensitive [ fhir:v true] ; # 
  fhir:content [ fhir:v "complete"] ; # 
  fhir:count [ fhir:v "4"^^xsd:nonNegativeInteger] ; # 
  fhir:concept ( [
     fhir:code [ fhir:v "authoritative" ] ;
     fhir:display [ fhir:v "Authoritative (set by a standards body)" ] ;
     fhir:definition [ fhir:v "A maximum or safe upper limit that a standards body sets for the animal and use it is applied to: in the source template, NRC's safe upper limits (as printed, as greater-than values and per kg BW^0.75 or BW^0.67, except those NRC states only for its reference kitten or queen), NRC's presumed safe maximum for choline, AAFCO's maximums (except while the AAFCO dry matter factor applies) and FEDIAF's nutritional maximums (except one used beyond the life stage it is stated for), and a maximum the source template copies from one of these. A value above it, and not below a minimum set by the applied standard, is `excess`." ]
  ] [
     fhir:code [ fhir:v "conditional" ] ;
     fhir:display [ fhir:v "Conditional (a standard's figure with a condition the check does not verify)" ] ;
     fhir:definition [ fhir:v "A standard's figure that is not a maximum for every diet and animal the check covers: a maximum that applies only under a condition the check does not verify (for example a FEDIAF legal maximum, for nutrients added as additives), a maximum used beyond the life stage or reference animal it is stated for, a level a FEDIAF footnote states to be safe, or an AAFCO maximum while the AAFCO dry matter factor applies. A value above it is not `excess`." ]
  ] [
     fhir:code [ fhir:v "template-set" ] ;
     fhir:display [ fhir:v "Template-set (set or computed by the source template)" ] ;
     fhir:definition [ fhir:v "A maximum that the source template sets or computes itself: its own estimates, fixed values and maximums calculated from other limits. A value above it is not `excess`." ]
  ] [
     fhir:code [ fhir:v "derived-provisional" ] ;
     fhir:display [ fhir:v "Derived-provisional (computed from the minimum; revisable)" ] ;
     fhir:definition [ fhir:v "The minimum times a disclosed multiplier, where no maximum is set: a banding device, not a safe limit. A value above it is not `excess`." ]
  ] ) . # 

